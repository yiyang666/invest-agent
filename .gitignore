.DS_Store
.env
.env.*
!.env.example
.venv/
.venv*/
.conda-env/
.conda-data-env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Credentials and sensitive local state
.aijijin/
credentials.json
**/credentials.json
*.token
*.secret

# Reviewed project-local third-party Skill is versioned; temporary downloads are not.
.agents/skills/thsfund/vendor-downloads/

# Local financial data and generated evidence. The repository contains schemas
# and sanitized examples only; real batches, snapshots, databases and reports
# never enter Git.
data/

# Databases, journals and runtime output in case a tool is pointed elsewhere.
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal
*.log
*.pid

# Private keys and certificate bundles.
*.pem
*.key
*.p12
*.pfx

# Machine-specific scheduler instances. Commit only the .plist.example template.
config/launchd/*.plist
