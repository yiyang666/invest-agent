        {"operation": "collect_jin10_calendar"}
      ]
    },
    {
      "job_id": "market_weekly_context",
      "cadence": "weekly",
      "weekday": "FR",
      "local_time": "23:50",
      "commands": [
        {"operation": "audit_schema"},
        {"operation": "collect_fred", "arguments": {"series": "NFCI", "lookback_days": 120}},
        {"tool": "list_datasets", "arguments": {}},
        {"tool": "get_index_valuation", "arguments": {}},
        {"tool": "get_index_forward_pe", "arguments": {}},
        {"tool": "get_industry_crowding", "arguments": {"angle": "composite", "history": false}}
      ]
    },
    {
      "job_id": "market_monthly_context",
      "cadence": "monthly",
      "calendar_day": 2,
      "local_time": "09:15",
      "commands": [
        {"tool": "get_index_weight", "arguments": {"index_code": "000016", "limit": 500}},
        {"tool": "get_index_weight", "arguments": {"index_code": "000300", "limit": 500}},
        {"tool": "get_index_weight", "arguments": {"index_code": "000688", "limit": 500}},
