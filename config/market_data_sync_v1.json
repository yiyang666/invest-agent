  "fred_policy": {
    "enabled": true,
    "transport": "public_graph_csv_download",
    "usage_scope": "personal_research_local_only",
    "redistribution_allowed": false,
    "series": {
      "NFCI": {
        "local_series_id": "financial_conditions:us:NFCI",
        "label": "芝加哥联储全国金融状况指数",
        "unit": "index",
        "frequency": "weekly",
        "source_owner": "Federal Reserve Bank of Chicago",
        "citation_url": "https://fred.stlouisfed.org/series/NFCI",
        "usage_scope": "personal_research_local_only"
      }
    }
  },
  "sse_breadth_policy": {
    "enabled": true,
    "endpoint": "https://yunhq.sse.com.cn:32042/v1/sh1/list/exchange/equity",
    "source_page": "https://www.sse.com.cn/market/price/trends/",
    "source_owner": "Shanghai Stock Exchange",
    "usage_scope": "personal_research_local_only",
    "universe": "equity_excluding_b_shares",
    "max_records": 4000,
    "minimum_final_time": "15:00:00",
    "history_policy": "accumulate_strict_observations_from_first_successful_collection",
    "coverage_limitation": "Shanghai exchange only; Shenzhen and Beijing exchanges are not included"
  },
  "guchacha_breadth_policy": {
    "enabled": true,
    "endpoint": "https://guchacha.com/dashboard",
    "source_owner": "Guchacha",
    "upstream_label": "东方财富全市场",
    "usage_scope": "personal_research_local_only",
    "universe": "provider_reported_all_a_shares",
    "minimum_final_time": "15:00:00",
    "history_policy": "accumulate_strict_observations_from_first_successful_collection",
    "denominator_policy": "advancers_plus_decliners_plus_unchanged"
  },
  "tool_policy": {
    "enabled_tools": [
      "list_datasets",
      "get_index_valuation",
      "get_index_weight",
      "get_index_forward_pe",
      "get_industry_crowding",
      "get_market_series",
      "get_macro"
    ],
    "allowed_market_series_datasets": ["bond_yield", "forex", "margin"],
    "allowed_market_series_keys": {
      "bond_yield": ["CN_2Y", "CN_10Y", "US_2Y", "US_10Y", "JP_2Y", "JP_10Y"],
      "forex": ["usdjpy", "eurusd", "gbpusd", "usdcny", "dxy"],
      "margin": ["margin_bal", "leverage_pct"]
    },
    "allowed_macro_indicators": ["cpi", "ppi", "pmi", "gdp", "buffett", "nonfarm"]
  },
  "bootstrap_commands": [
    {"operation": "audit_schema"},
    {"operation": "publish_fund_proxies", "arguments": {"history": true}},
    {"operation": "collect_fred", "arguments": {"series": "NFCI", "lookback_days": 0}},
    {"operation": "collect_guchacha_breadth"},
    {"tool": "get_index_valuation", "arguments": {"index_code": "000300", "metric": "pe_ttm", "window": "since", "history": true}},
    {"tool": "get_index_valuation", "arguments": {"index_code": "000688", "metric": "pe_ttm", "window": "since", "history": true}},
    {"tool": "get_index_valuation", "arguments": {"index_code": "399006", "metric": "pe_ttm", "window": "since", "history": true}},
