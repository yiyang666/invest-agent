        {"operation": "collect_guchacha_breadth"},
        {"tool": "get_market_series", "arguments": {"dataset": "bond_yield", "key": "CN_2Y", "limit": 10}},
        {"tool": "get_market_series", "arguments": {"dataset": "bond_yield", "key": "CN_10Y", "limit": 10}},
        {"tool": "get_market_series", "arguments": {"dataset": "bond_yield", "key": "US_2Y", "limit": 10}},
