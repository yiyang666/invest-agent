    {"tool": "get_market_series", "arguments": {"dataset": "bond_yield", "key": "CN_2Y", "limit": 500}},
    {"tool": "get_market_series", "arguments": {"dataset": "bond_yield", "key": "CN_10Y", "limit": 500}},
