        {"tool": "get_macro", "arguments": {"indicator": "pmi", "limit": 24}},
        {"tool": "get_macro", "arguments": {"indicator": "buffett", "limit": 40}},
        {"tool": "get_macro", "arguments": {"indicator": "nonfarm", "limit": 24}}
      ]
    },
    {
      "job_id": "market_quarterly_context",
      "cadence": "quarterly",
      "months": [1, 4, 7, 10],
      "calendar_day": 20,
      "local_time": "09:30",
      "commands": [
        {"tool": "get_macro", "arguments": {"indicator": "gdp", "limit": 20}}
      ]
    }
  ],
  "safety": {
    "trading_allowed": false,
    "strategy_inference_allowed": false,
    "fallback_to_mock_data": false,
    "publish_failed_batches": false,
    "codex_required_for_collection": false
